# HackBarna environment variables
# Copy this file to .env and fill in your actual keys.
# .env is git-ignored and never committed.

# SLNG (voice API): get it from https://app.slng.ai/projects
SLNG_API_KEY=

# Anthropic Claude API (if needed for backend/evals)
ANTHROPIC_API_KEY=

# Other services (add as needed)
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
