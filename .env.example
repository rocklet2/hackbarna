# HackBarna environment variables
# Copy this file to .env and fill in your actual keys.
# .env is git-ignored and never committed.

# OpenAI API — powers the lesson page's per-step text-to-speech (scripts/tts-proxy.js) and the
# bottom-right voice character on welcome.html, which uses the Realtime API over WebRTC
# (scripts/openai-realtime-proxy.js).
OPENAI_API_KEY=

# Anthropic Claude API (if needed for backend/evals)
ANTHROPIC_API_KEY=

# Other services (add as needed)
# OPENROUTER_API_KEY=
